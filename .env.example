ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app
ENV=production
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Security / Auth
# -----------------------------------------------------------------------------
# Must be at least 32 random characters in production.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_super_secret_jwt_key_here
# Shared secret for manual triggering of /internal endpoints (scheduler webhooks)
INTERNAL_API_KEY=your_internal_api_key_here

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------

# Phase A — Postgres (use the Neon pooled -pooler hostname, not the direct one)
DATABASE_URL=postgresql://user:password@ep-your-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Phase A — Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=applyops-resumes
